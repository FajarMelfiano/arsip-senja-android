<?xml version="1.0" encoding="utf-8"?>
<!--
  Arsip Senja memegang data sensitif (sesi Telegram, kredensial API).
  Backup sistem dimatikan; file ini hanya formalitas untuk API 31+.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
